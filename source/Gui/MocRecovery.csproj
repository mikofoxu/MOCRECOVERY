<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><PlatformTarget>x64</PlatformTarget><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>MocRecovery</AssemblyName><Version>2.0.3</Version><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode><PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><DebugType>none</DebugType></PropertyGroup>
<ItemGroup><ProjectReference Include="../Core/Recovery.Core.csproj"/><EmbeddedResource Include="../engine/moc-recover.exe" LogicalName="MocRecovery.Engine.exe"/></ItemGroup>
<ItemGroup>
  <Content Include="../../CHANGES.md" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
</ItemGroup>
<UsingTask TaskName="CheckReleaseNotes" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
  <ParameterGroup>
    <NotesDirectory ParameterType="System.String" Required="true" />
    <ReleaseVersion ParameterType="System.String" Required="true" />
  </ParameterGroup>
  <Task>
    <Code Type="Fragment" Language="cs"><![CDATA[
      var history = System.IO.Path.Combine(NotesDirectory, "CHANGES.md");
      if (!System.IO.File.Exists(history) ||
          !string.Equals(System.IO.File.ReadLines(history).FirstOrDefault(), "# MocRecovery " + ReleaseVersion, StringComparison.Ordinal))
      {
          Log.LogError("Start CHANGES.md with the current release heading for {0}.", ReleaseVersion);
          return false;
      }
    ]]></Code>
  </Task>
</UsingTask>
<Target Name="ValidateReleaseNotes" BeforeTargets="PrepareForPublish">
  <CheckReleaseNotes NotesDirectory="$(MSBuildProjectDirectory)/../.." ReleaseVersion="$(Version)" />
</Target>
</Project>
