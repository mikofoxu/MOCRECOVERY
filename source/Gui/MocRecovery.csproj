<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><PlatformTarget>x64</PlatformTarget><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>MocRecovery</AssemblyName><Version>1.91</Version><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode><PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><DebugType>none</DebugType></PropertyGroup>
<ItemGroup><ProjectReference Include="../Core/Recovery.Core.csproj"/><EmbeddedResource Include="../engine/moc-recover.exe" LogicalName="MocRecovery.Engine.exe"/></ItemGroup>
<ItemGroup>
  <Content Include="../CHANGES.md;../CHANGES-$(Version).md" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
</ItemGroup>
<UsingTask TaskName="CheckReleaseNotes" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
  <ParameterGroup>
    <NotesDirectory ParameterType="System.String" Required="true" />
    <ReleaseVersion ParameterType="System.String" Required="true" />
  </ParameterGroup>
  <Task>
    <Code Type="Fragment" Language="cs"><![CDATA[
      var history = System.IO.Path.Combine(NotesDirectory, "CHANGES.md");
      var notes = System.IO.Path.Combine(NotesDirectory, "CHANGES-" + ReleaseVersion + ".md");
      if (!System.IO.File.Exists(history) || !System.IO.File.Exists(notes))
      {
          Log.LogError("Release {0} requires CHANGES.md and CHANGES-{0}.md.", ReleaseVersion);
          return false;
      }
      var entry = System.IO.File.ReadAllText(notes).Replace("\r\n", "\n").TrimEnd();
      var log = System.IO.File.ReadAllText(history).Replace("\r\n", "\n").TrimEnd();
      var heading = "# MocRecovery " + ReleaseVersion + "\n";
      if (!entry.StartsWith(heading, StringComparison.Ordinal) ||
          !(log == entry || log.StartsWith(entry + "\n", StringComparison.Ordinal)))
      {
          Log.LogError("Start CHANGES.md with the full current release entry from {0}.", notes);
          return false;
      }
    ]]></Code>
  </Task>
</UsingTask>
<Target Name="ValidateReleaseNotes" BeforeTargets="PrepareForPublish">
  <CheckReleaseNotes NotesDirectory="$(MSBuildProjectDirectory)/.." ReleaseVersion="$(Version)" />
</Target>
</Project>
